id;grid-template-columns:minmax(0,1fr) auto;gap:5px 18px;padding:17px 4px;border-bottom:1px solid var(--line);align-items:center}.focus-history-item strong{font-size:13px;overflow-wrap:anywhere}.focus-history-item>span:not(.focus-outcome){font-size:11px;color:var(--muted)}.focus-outcome{grid-column:2;grid-row:1/3;align-self:center}.focus-outcome.finishedEarly{background:#eeeacf;color:#75652e}.focus-outcome.cancelled{background:#f3e7dd;color:#924c36}.history-empty{font-size:12px;color:var(--muted);padding:4px 0 21px}\n@media(max-width:700px){.focus-workspace{padding:20px 17px;margin-bottom:28px}.focus-heading h2{font-size:25px}.focus-form,.focus-active{grid-template-columns:1fr}.focus-form .primary{grid-column:auto}.focus-active{gap:17px}.focus-countdown{text-align:left}.focus-actions{grid-column:auto}.focus-actions .primary{width:auto}.focus-history-item{grid-template-columns:minmax(0,1fr) auto;gap:5px 10px}}\n","stderr":"","aggregated_output":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"theme-color\" content=\"#f7f6f0\"><title>Focus Desk</title>\n  <link rel=\"icon\" href=\"data:,\"><link rel=\"stylesheet\" href=\"/styles.css\">\n  <script type=\"module\" src=\"/src/app.js\"></script>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#main\">Skip to workspace</a>\n  <div class=\"app-shell\">\n    <aside class=\"sidebar\">\n      <a href=\"/\" class=\"brand\"><span class=\"brand-mark\" aria-hidden=\"true\">f.</span><span>Focus Desk<span class=\"brand-sub\">A little more intention.</span></span></a>\n      <p class=\"eyebrow workspace-label\">YOUR WORKSPACE</p>\n      <nav aria-label=\"Workspace\">\n        <a class=\"nav-item selected\" href=\"#main\" aria-current=\"page\"><span aria-hidden=\"true\">▤</span> Tasks <span class=\"nav-count\" id=\"nav-count\">0</span></a>\n        <a class=\"nav-item\" href=\"#focus-workspace\"><span aria-hidden=\"true\">◷</span> Focus <small>Timer &amp; history</small></a>\n        <button class=\"nav-item\" disabled><span aria-hidden=\"true\">▦</span> Daily plan <small>Coming later</small></button>\n        <button class=\"nav-item\" disabled><span aria-hidden=\"true\">↗</span> Insights <small>Coming later</small></button>\n      </nav>\n      <div class=\"sidebar-note\"><span class=\"small-orbit\" aria-hidden=\"true\">✳</span><p>Make room for<br>what matters.</p><span>One task at a time.</span></div>\n      <div class=\"storage-label\"><span aria-hidden=\"true\">●</span> Stored in this browser</div>\n    </aside>\n    <main id=\"main\" tabindex=\"-1\">\n      <header class=\"topbar\"><span>YOUR PERSONAL WORKSPACE</span><time id=\"today\"></time></header>\n      <section class=\"intro\" aria-labelledby=\"page-title\"><div><p class=\"eyebrow\">CLEAR SPACE. FIND FOCUS.</p><h1 id=\"page-title\">A place for your tasks.</h1><p class=\"subtitle\">Get it out of your head. Take it one step at a time.</p></div><button class=\"primary\" id=\"new-task\"><span aria-hidden=\"true\">＋</span> New task</button></section>\n      <div id=\"storage-error\" class=\"notice\" role=\"alert\" hidden></div>\n      <section class=\"focus-workspace\" id=\"focus-workspace\" aria-labelledby=\"focus-heading\">\n        <div class=\"focus-heading\"><div><p class=\"eyebrow\">ONE TASK AT A TIME</p><h2 id=\"focus-heading\">Focus timer</h2></div><span class=\"focus-state\" id=\"focus-state\">Ready</span></div>\n        <div id=\"focus-storage-error\" class=\"notice\" role=\"alert\" hidden></div>\n        <div class=\"focus-setup\" id=\"focus-setup\">\n          <p>Choose a task and make a little room for it. The timer starts at 25 minutes.</p>\n          <form id=\"focus-form\" class=\"focus-form\">\n            <label for=\"focus-task\">Task<select id=\"focus-task\" required></select></label>\n            <label for=\"focus-duration\">Duration<select id=\"focus-duration\"><option value=\"15\">15 minutes</option><option value=\"25\" selected>25 minutes</option><option value=\"45\">45 minutes</option><option value=\"60\">60 minutes</option></select></label>\n            <button class=\"primary\" type=\"submit\">Start focus</button>\n          </form>\n          <p class=\"focus-empty\" id=\"focus-empty\">Add a task to begin a focus session.</p>\n        </div>\n        <div class=\"focus-active\" id=\"focus-timer\" hidden aria-live=\"polite\">\n          <div><p class=\"focus-label\">Focusing on</p><h3 id=\"focus-title\"></h3><p class=\"focus-note\" id=\"focus-timer-note\" hidden>The timer was paused after a refresh. Resume when you’re ready.</p></div>\n          <div class=\"focus-countdown\"><span>Remaining</span><strong id=\"focus-remaining\">25m 00s</strong><small><span id=\"focus-elapsed\">0m 00s</span> focused</small></div>\n          <div class=\"focus-actions\"><button class=\"secondary\" type=\"button\" id=\"focus-pause\">Pause</button><button class=\"primary\" type=\"button\" id=\"focus-resume\" hidden>Resume</button><button class=\"text-button\" type=\"button\" id=\"focus-finish\">Finish early</button><button class=\"text-button\" type=\"button\" id=\"focus-cancel\">Cancel session</button></div>\n        </div>\n      </section>\n      <section class=\"stats\" aria-label=\"Task overview\">\n        <div class=\"stat\"><span>Open tasks</span><strong id=\"open-count\">0</strong><small>Room to make progress</small></div>\n        <div class=\"stat\"><span>Due today</span><strong id=\"due-count\">0</strong><small>A little attention today</small></div>\n        <div class=\"stat\"><span>Completed</span><strong id=\"completed-count\">0</strong><small>Every step counts</small></div>\n      </section>\n      <section class=\"task-workspace\" aria-labelledby=\"list-title\">\n        <div class=\"list-heading\"><h2 id=\"list-title\">Your tasks <span id=\"result-count\">0</span></h2><span class=\"list-hint\">Small steps, steady progress.</span></div>\n        <div class=\"toolbar\">\n          <label class=\"search-field\"><span class=\"sr-only\">Search task titles</span><span aria-hidden=\"true\">⌕</span><input id=\"search\" type=\"search\" placeholder=\"Search task titles…\" autocomplete=\"off\"></label>\n          <label class=\"filter-label\">Status<select id=\"status\"><option value=\"all\">All tasks</option><option value=\"open\">Open</option><option value=\"completed\">Completed</option></select></label>\n          <label class=\"filter-label\">Priority<select id=\"priority\"><option value=\"all\">All priorities</option><option>High</option><option>Medium</option><option>Low</option></select></label>\n          <button id=\"clear-filters\" class=\"text-button\" hidden>Clear filters</button>\n        </div>\n        <p class=\"sr-only\" id=\"results-announcement\" role=\"status\"></p>\n        <ul id=\"task-list\" class=\"task-list\"></ul>\n        <div class=\"empty-state\" id=\"empty-state\"><div class=\"empty-art\" aria-hidden=\"true\"><span>✓</span><i></i><i></i></div><h3 id=\"empty-title\">A clear desk. A fresh start.</h3><p id=\"empty-description\">Add your first task and give your next step a home.</p><button class=\"secondary\" id=\"empty-action\">Create your first task <span aria-hidden=\"true\">↗</span></button></div>\n      </section>\n      <section class=\"focus-history\" aria-labelledby=\"focus-history-heading\">\n        <div class=\"list-heading\"><h2 id=\"focus-history-heading\">Focus history</h2><span class=\"list-hint\">Actual focused time is retained here.</span></div>\n        <p id=\"focus-history-empty\" class=\"history-empty\">Your finished sessions will appear here.</p>\n        <ul id=\"focus-history\" class=\"focus-history-list\"></ul>\n      </section>\n      <footer>Less noise. More intention.<span>Your tasks stay here until you delete them.</span></footer>\n      <p class=\"toast\" id=\"feedback\" role=\"status\" hidden></p>\n    </main>\n  </div>\n  <dialog id=\"task-dialog\" aria-labelledby=\"dialog-title\">\n    <form id=\"task-form\" novalidate>\n      <div class=\"dialog-heading\"><div><p class=\"eyebrow\">MAKE A LITTLE SPACE</p><h2 id=\"dialog-title\">New task</h2></div><button type=\"button\" class=\"icon-button\" id=\"close-dialog\" aria-label=\"Close task form\">×</button></div>\n      <p class=\"form-intro\">A clear next step is a good place to start.</p>\n      <label for=\"title\">Task title <span class=\"required\">Required</span></label><input id=\"title\" name=\"title\" maxlength=\"120\" required placeholder=\"What would you like to get done?\" aria-describedby=\"title-error\"><p class=\"field-error\" id=\"title-error\"></p>\n      <label for=\"notes\">Notes <span class=\"optional\">Optional · 2,000 characters max</span></label><textarea id=\"notes\" name=\"notes\" maxlength=\"2000\" rows=\"4\" placeholder=\"A few details, an idea, a reminder…\" aria-describedby=\"notes-error\"></textarea><p class=\"field-error\" id=\"notes-error\"></p>\n      <div class=\"form-grid\"><div><label for=\"task-priority\">Priority</label><select id=\"task-priority\" name=\"priority\" aria-describedby=\"priority-error\"><option>Low</option><option selected>Medium</option><option>High</option></select><p class=\"field-error\" id=\"priority-error\"></p></div><div><label for=\"due-date\">Due date <span class=\"optional\">Optional</span></label><input id=\"due-date\" name=\"dueDate\" type=\"date\" min=\"0001-01-01\" max=\"9999-12-31\" aria-describedby=\"dueDate-error\"><p class=\"field-error\" id=\"dueDate-error\"></p></div></div>\n      <label for=\"estimate\">Estimated minutes</label><input id=\"estimate\" class=\"estimate-input\" name=\"estimatedMinutes\" type=\"number\" min=\"5\" max=\"480\" step=\"1\" value=\"25\" required aria-describedby=\"estimate-help estimatedMinutes-error\"><span class=\"field-hint\" id=\"estimate-help\">5–480 minutes, in whole numbers</span><p class=\"field-error\" id=\"estimatedMinutes-error\"></p>\n      <p class=\"notice\" id=\"form-error\" role=\"alert\" hidden></p>\n      <div class=\"dialog-actions\"><button type=\"button\" class=\"secondary\" id=\"cancel-dialog\">Cancel</button><button class=\"primary\" type=\"submit\" id=\"save-task\">Create task</button></div>\n    </form>\n  </dialog>\n  <dialog id=\"delete-dialog\" aria-labelledby=\"delete-title\" aria-describedby=\"delete-description\"><form id=\"delete-form\"><p class=\"eyebrow\">A MOMENT TO CHECK</p><h2 id=\"delete-title\">Delete this task?</h2><p id=\"delete-description\"></p><p class=\"form-intro\">This cannot be undone.</p><p id=\"delete-error\" class=\"notice\" role=\"alert\" hidden></p><div class=\"dialog-actions\"><button type=\"button\" class=\"secondary\" id=\"cancel-delete\" autofocus>Keep task</button><button type=\"submit\" class=\"danger\">Delete task</button></div></form></dialog>\n</body>\n</html>\n:root{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#243c39;background:#f7f6f0;font-synthesis:none;--teal:#2c675d;--ink:#233a35;--muted:#64716b;--line:#dddfd5;--paper:#fffef9}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button,a,input,select,textarea{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:disabled{cursor:default}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #bd7543;outline-offset:3px}button{border:0}button:disabled{opacity:.55}[hidden]{display:none!important}.app-shell{display:grid;grid-template-columns:246px minmax(0,1fr);min-height:100vh}.sidebar{background:#edeee5;border-right:1px solid var(--line);padding:40px 24px 24px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:12px;font-weight:750;letter-spacing:-.6px;font-size:21px}.brand-mark{width:39px;height:42px;background:var(--teal);color:#f5f4e9;border-radius:13px 13px 13px 3px;font-family:Georgia,serif;font-size:32px;display:grid;pl