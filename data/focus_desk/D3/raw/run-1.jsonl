;\n   123\t  for (const [name, message] of Object.entries(errors)) {\n   124\t    const input = elements.form.elements.namedItem(name);\n   125\t    const error = document.querySelector(`#${name}-error`);\n   126\t    if (input) input.setAttribute('aria-invalid', 'true');\n   127\t    if (error) error.textContent = message;\n   128\t  }\n   129\t}\n   130\t\n   131\tfunction persist(nextTasks) {\n   132\t  if (!storageState.writable) return false;\n   133\t  const result = saveTasks(browserStorage, nextTasks);\n   134\t  if (!result.ok) {\n   135\t    setNotice(elements.storageError, result.message);\n   136\t    showFeedback('Your change could not be saved.');\n   137\t    return false;\n   138\t  }\n   139\t  tasks = nextTasks;\n   140\t  return true;\n   141\t}\n   142\t\n   143\tfunction persistFocus(nextActiveSession, nextHistory) {\n   144\t  if (!focusWritable) return false;\n   145\t  const result = saveFocusData(browserStorage, nextActiveSession, nextHistory);\n   146\t  if (!result.ok) {\n   147\t    focusWritable = false;\n   148\t    setNotice(elements.focusStorageError, result.message);\n   149\t    showFeedback('Your focus session could not be saved.');\n   150\t    renderFocus();\n   151\t    return false;\n   152\t  }\n   153\t  activeFocusSession = nextActiveSession;\n   154\t  focusHistory = nextHistory;\n   155\t  return true;\n   156\t}\n   157\t\n   158\tfunction renderTask(task) {\n   159\t  const item = document.createElement('li');\n   160\t  item.className = `task-card${task.completed ? ' completed' : ''}`;\n   161\t  item.dataset.taskId = task.id;\n   162\t\n   163\t  const check = document.createElement('input');\n   164\t  check.className = 'task-check';\n   165\t  check.type = 'checkbox';\n   166\t  check.checked = task.completed;\n   167\t  check.dataset.action = 'toggle';\n   168\t  check.setAttribute('aria-label', `${task.completed ? 'Reopen' : 'Mark'} ${task.title}`);\n   169\t  item.append(check);\n   170\t\n   171\t  const content = document.createElement('div');\n   172\t  content.className = 'task-content';\n   173\t  const title = document.createElement('p');\n   174\t  title.className = 'task-title';\n   175\t  title.textContent = task.title;\n   176\t  content.append(title);\n   177\t  if (task.notes) {\n   178\t    const notes = document.createElement('p');\n   179\t    notes.className = 'task-notes';\n   180\t    notes.textContent = task.notes;\n   181\t    content.append(notes);\n   182\t  }\n   183\t  const meta = document.createElement('div');\n   184\t  meta.className = 'task-meta';\n   185\t  const priority = document.createElement('span');\n   186\t  priority.className = `badge priority-${task.priority.toLowerCase()}`;\n   187\t  priority.textContent = task.priority;\n   188\t  meta.append(priority);\n   189\t  if (task.dueDate) {\n   190\t    const due = document.createElement('span');\n   191\t    due.textContent = `Due ${formatDueDate(task.dueDate)}`;\n   192\t    if (!task.completed && task.dueDate < localToday()) due.className = 'overdue';\n   193\t    meta.append(due);\n   194\t  }\n   195\t  const estimate = document.createElement('span');\n   196\t  estimate.textContent = `${task.estimatedMinutes} min`;\n   197\t  meta.append(estimate);\n   198\t  content.append(meta);\n   199\t  item.append(content);\n   200\t\n   201\t  const actions = document.createElement('div');\n   202\t  actions.className = 'task-actions';\n   203\t  for (const [action, label] of [['focus', 'Focus'], ['edit', 'Edit'], ['delete', 'Delete']]) {\n   204\t    const button = document.createElement('button');\n   205\t    button.type = 'button';\n   206\t    button.className = 'icon-button';\n   207\t    button.dataset.action = action;\n   208\t    button.textContent = label;\n   209\t    button.setAttribute('aria-label', `${label} ${task.title}`);\n   210\t    actions.append(button);\n   211\t  }\n   212\t  item.append(actions);\n   213\t  return item;\n   214\t}\n   215\t\n   216\tfunction focusOutcomeLabel(outcome) {\n   217\t  return { completed: 'Completed', finishedEarly: 'Finished early', cancelled: 'Cancelled' }[outcome];\n   218\t}\n   219\t\n   220\tfunction formatFocusDate(value) {\n   221\t  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(value));\n   222\t}\n   223\t\n   224\tfunction updateFocusTimer() {\n   225\t  if (!activeFocusSession) return;\n   226\t  const progress = focusProgress(activeFocusSession);\n   227\t  elements.focusElapsed.textContent = formatFocusDuration(progress.focusedMilliseconds);\n   228\t  elements.focusRemaining.textContent = formatFocusDuration(progress.remainingMilliseconds);\n   229\t  if (progress.complete) completeFocusSession();\n   230\t}\n   231\t\n   232\tfunction syncFocusTimer() {\n   233\t  window.clearInterval(focusTimerInterval);\n   234\t  if (activeFocusSession?.status === 'running') {\n   235\t    updateFocusTimer();\n   236\t    if (activeFocusSession?.status !== 'running') return;\n   237\t    focusTimerInterval = window.setInterval(() => {\n   238\t      if (!activeFocusSession || document.hidden) return;\n   239\t      const checkpoint = checkpointFocusSession(activeFocusSession);\n   240\t      if (persistFocus(checkpoint, focusHistory)) {\n   241\t        renderFocus();\n   242\t        if (focusProgress(activeFocusSession).complete) completeFocusSession();\n   243\t      }\n   244\t    }, 1000);\n   245\t  }\n   246\t}\n   247\t\n   248\tfunction completeFocusSession() {\n   249\t  if (!activeFocusSession) return;\n   250\t  const record = finishFocusSession(activeFocusSession, 'completed');\n   251\t  if (persistFocus(null, [record, ...focusHistory])) {\n   252\t    focusRecoveryNotice = false;\n   253\t    renderFocus();\n   254\t    syncFocusTimer();\n   255\t    showFeedback('Focus session completed.');\n   256\t  }\n   257\t}\n   258\t\n   259\tfunction endFocusSession(outcome) {\n   260\t  if (!activeFocusSession) return;\n   261\t  const record = finishFocusSession(activeFocusSession, outcome);\n   262\t  if (persistFocus(null, [record, ...focusHistory])) {\n   263\t    focusRecoveryNotice = false;\n   264\t    renderFocus();\n   265\t    syncFocusTimer();\n   266\t    showFeedback(outcome === 'cancelled' ? 'Focus session cancelled.' : 'Focus session finished early.');\n   267\t  }\n   268\t}\n   269\t\n   270\tfunction pauseActiveFocus(message = 'Focus timer paused.') {\n   271\t  if (!activeFocusSession || activeFocusSession.status !== 'running') return;\n   272\t  const paused = pauseFocusSession(activeFocusSession);\n   273\t  if (focusProgress(paused).complete) {\n   274\t    const record = finishFocusSession(paused, 'completed');\n   275\t    if (persistFocus(null, [record, ...focusHistory])) {\n   276\t      renderFocus();\n   277\t      syncFocusTimer();\n   278\t      showFeedback('Focus session completed.');\n   279\t    }\n   280\t    return;\n   281\t  }\n   282\t  if (persistFocus(paused, focusHistory)) {\n   283\t    renderFocus();\n   284\t    syncFocusTimer();\n   285\t    showFeedback(message);\n   286\t  }\n   287\t}\n   288\t\n   289\tfunction renderFocus() {\n   290\t  const selectedTaskId = elements.focusTask.value;\n   291\t  elements.focusTask.replaceChildren(...tasks.map(task => {\n   292\t    const option = document.createElement('option');\n   293\t    option.value = task.id;\n   294\t    option.textContent = task.title;\n   295\t    return option;\n   296\t  }));\n   297\t  if (tasks.some(task => task.id === selectedTaskId)) elements.focusTask.value = selectedTaskId;\n   298\t  else if (tasks.length) elements.focusTask.value = tasks[0].id;\n   299\t  const hasActive = Boolean(activeFocusSession);\n   300\t  elements.focusSetup.hidden = hasActive;\n   301\t  elements.focusForm.hidden = hasActive;\n   302\t  elements.focusTimerNote.hidden = !focusRecoveryNotice;\n   303\t  elements.focusTimer.hidden = !hasActive;\n   304\t  if (hasActive) {\n   305\t    const progress = focusProgress(activeFocusSession);\n   306\t    elements.focusTitle.textContent = activeFocusSession.taskTitle;\n   307\t    elements.focusState.textContent = activeFocusSession.status === 'running' ? 'Running' : 'Paused';\n   308\t    elements.focusElapsed.textContent = formatFocusDuration(progress.focusedMilliseconds);\n   309\t    elements.focusRemaining.textContent = formatFocusDuration(progress.remainingMilliseconds);\n   310\t    elements.focusPause.hidden = activeFocusSession.status !== 'running';\n   311\t    elements.focusResume.hidden = activeFocusSession.status !== 'paused';\n   312\t  } else {\n   313\t    elements.focusState.textContent = 'Ready';\n   314\t  }\n   315\t  elements.focusTask.disabled = !focusWritable || !tasks.length;\n   316\t  elements.focusDuration.disabled = !focusWritable || !tasks.length;\n   317\t  elements.focusEmpty.hidden = tasks.length > 0;\n   318\t  elements.focusForm.querySelector('button[type=\"submit\"]').disabled = !focusWritable || !tasks.length;\n   319\t  elements.focusPause.disabled = !focusWritable;\n   320\t  elements.focusResume.disabled = !focusWritable;\n   321\t  elements.focusFinish.disabled = !focusWritable;\n   322\t  elements.focusCancel.disabled = !focusWritable;\n   323\t  elements.focusHistory.replaceChildren(...focusHistory.map(record => {\n   324\t    const item = document.createElement('li');\n   325\t    item.className = 'focus-history-item';\n   326\t    const title = document.createElement('strong');\n   327\t    title.textContent = record.taskTitle;\n   328\t    const detail = document.createElement('span');\n   329\t    detail.textContent = `${formatFocusDuration(record.focusedMilliseconds)} focused · ${formatFocusDate(record.endedAt)}`;\n   330\t    const outcome = document.createElement('span');\n   331\t    outcome.className = `focus-outcome ${record.outcome}`;\n   332\t    outcome.textContent = focusOutcomeLabel(record.outcome);\n   333\t    item.append(title, detail, outcome);\n   334\t    return item;\n   335\t  }));\n   336\t  elements.focusHistoryEmpty.hidden = focusHistory.length > 0;\n   337\t}\n   338\t\n   339\tfunction render() {\n   340\t  const filtered = filterTasks(tasks, activeFilters());\n   341\t  const open = tasks.filter(task => !task.completed);\n   342\t  const today = localToday();\n   343\t  const completed = tasks.length - open.length;\n   344\t  setText('#open-count', open.length);\n   345\t  setText('#due-count', open.filter(task => task.dueDate === today).length);\n   346\t  setText('#completed-count', completed);\n   347\t  setText('#nav-count', open.length);\n   348\t  setText('#result-count', filtered.length);\n   349\t  elements.resultsAnnouncement.textContent = `${filtered.length} ${filtered.length === 1 ? 'task' : 'tasks'} shown.`;\n   350\t  elements.clearFilters.hidden = !elements.search.value && elements.status.value === 'all' && elements.priority.value === 'all';\n   351\t  elements.taskList.replaceChildren(...filtered.map(renderTask));\n   352\t  const hasFilters = filtered.length !== tasks.length;\n   353\t  elements.emptyState.hidden = filtered.length > 0;\n   354\t  elements.emptyTitle.textContent = hasFilters ? 'No tasks match these filters.' : 'A clear desk. A fresh start.';\n   355\t  elements.emptyDescription.textContent = hasFilters ? 'Try a different search, status, or priority.' : 'Add your first task and give your next step a home.';\n   356\t  elements.emptyAction.textContent = hasFilters ? 'Clear filters' : 'Create your first task';\n   357\t  renderFocus();\n   358\t}\n   359\t\n   360\tfunction openTaskDialog(task = null, trigger = null) {\n   361\t  if (!storageState.writable) return;\n   362\t  opener = trigger;\n   363\t  editableTaskId = task?.id ?? null;\n   364\t  clearFieldErrors();\n   365\t  elements.form.reset();\n   366\t  elements.form.elements.priority.value = task?.priority ?? 'Medium';\n   367\t  elements.form.elements.estimatedMinutes.value = task?.estimatedMinutes ?? 25;\n   368\t  elements.form.elements.title.value = task?.title ?? '';\n   369\t  elements.form.elements.notes.value = task?.notes ?? '';\n   370\t  elements.form.elements.dueDate.value = task?.dueDate ?? '';\n   371\t  elements.dialogTitle.textContent = task ? 'Edit task' : 'New task';\n   372\t  elements.saveTask.textContent = task ? 'Save changes' : 'Create task';\n   373\t  elements.taskDialog.showModal();\n   374\t  window.setTimeout(() => elements.form.elements.title.focus(), 0);\n   375\t}\n   376\t\n   377\tfunction closeTaskDialog() {\n   378\t  elements.taskDialog.close();\n   379\t  opener?.focus();\n   380\t}\n   381\t\n   382\tfunction openDeleteDialog(task, trigger) {\n   383\t  if (!storageState.writable) return;\n   384\t  deletingTaskId = task.id;\n   385\t  opener = trigger;\n   386\t  setNotice(elements.deleteError, '');\n   387\t  elements.deleteDescription.textContent = `“${task.title}” will be permanently removed.`;\n   388\t  elements.deleteDialog.showModal();\n   389\t}\n   390\t\n   391\tfunction closeDeleteDialog() {\n   392\t  elements.deleteDialog.close();\n   393\t  opener?.focus();\n   394\t}\n   395\t\n   396\tfunction saveForm(event) {\n   397\t  event.preventDefault();\n   398\t  const input = {\n   399\t    title: elements.form.elements.title.value,\n   400\t    notes: elements.form.elements.notes.value,\n   401\t    priority: elements.form.elements.priority.value,\n   402\t    dueDate: elements.form.elements.dueDate.value,\n   403\t    estimatedMinutes: Number(elements.form.elements.estimatedMinutes.value)\n   404\t  };\n   405\t  try {\n   406\t    const now = new Date().toISOString();\n   407\t    const existing = editableTaskId ? tasks.find(task => task.id === editableTaskId) : null;\n   408\t    const next = existing\n   409\t      ? tasks.map(task => task.id === existing.id ? editTask(existing, input, now) : task)\n   410\t      : [createTask(input, { now }), ...tasks];\n   411\t    if (!existing && editableTaskId) throw new Error('This task is no longer available. Please reopen the task list.');\n   412\t    if (!persist(next)) return;\n   413\t    closeTaskDialog();\n   414\t    render();\n   415\t    showFeedback(existing ? 'Task updated.' : 'Task created.');\n   416\t  } catch (error) {\n   417\t    const message = String(error.message || error);\n   418\t    const mapping = {\n   419\t      'Enter a title of 1–120 characters.': 'title',\n   420\t      'Notes must be 2,000 characters or fewer.': 'notes',\n   421\t      'Choose Low, Medium, or High.': 'priority',\n   422\t      'Enter a valid calendar date.': 'dueDate',\n   423\t      'Enter a whole number from 5 to 480.': 'estimatedMinutes'\n   424\t    };\n   425\t    const field = mapping[message];\n   426\t    if (field) showFieldErrors({ [field]: message });\n   427\t    else setNotice(elements.formError, message);\n   428\t  }\n   429\t}\n   430\t\n   431\tfunction taskAction(event) {\n   432\t  const control = event.target.closest('[data-action]');\n   433\t  if (!control) return;\n   434\t  if (control.dataset.action === 'toggle' && event.type !== 'change') return;\n   435\t  if (control.dataset.action !== 'toggle' && event.type !== 'click') return;\n   436\t  const card = control.closest('[data-task-id]');\n   437\t  const task = tasks.find(candidate => candidate.id === card?.dataset.taskId);\n   438\t  if (!task) return;\n   439\t  if (control.dataset.action === 'toggle') {\n   440\t    const nextTask = setTaskCompleted(task, control.checked);\n   441\t    if (persist(tasks.map(candidate => candidate.id === task.id ? nextTask : candidate))) {\n   442\t      render();\n   443\t      showFeedback(nextTask.completed ? 'Task completed.' : 'Task reopened.');\n   444\t    } else control.checked = task.completed;\n   445\t  }\n   446\t  if (control.dataset.action === 'focus') {\n   447\t    elements.focusTask.value = task.id;\n   448\t    document.querySelector('#focus-workspace').scrollIntoView({ behavior: 'smooth', block: 'start' });\n   449\t    elements.focusTask.focus({ preventScroll: true });\n   450\t  }\n   451\t  if (control.dataset.action === 'edit') openTaskDialog(task, control);\n   452\t  if (control.dataset.action === 'delete') openDeleteDialog(task, control);\n   453\t}\n   454\t\n   455\telements.newTask.addEventListener('click', event => openTaskDialog(null, event.currentTarget));\n   456\telements.emptyAction.addEventListener('click', event => {\n   457\t  if (elements.clearFilters.hidden) openTaskDialog(null, event.currentTarget);\n   458\t  else {\n   459\t    elements.search.value = '';\n   460\t    elements.status.value = 'all';\n   461\t    elements.priority.value = 'all';\n   462\t    render();\n   463\t  }\n   464\t});\n   465\telements.closeDialog.addEventListener('click', closeTaskDialog);\n   466\telements.cancelDialog.addEventListener('click', closeTaskDialog);\n   467\telements.form.addEventListener('submit', saveForm);\n   468\telements.taskList.addEventListener('click', taskAction);\n   469\telements.taskList.addEventListener('change', taskAction);\n   470\tfor (const element of [elements.search, elements.status, elements.priority]) element.addEventListener('input', render);\n   471\telements.clearFilters.addEventListener('click', () => {\n   472\t  elements.search.value = '';\n   473\t  elements.status.value = 'all';\n   474\t  elements.priority.value = 'all';\n   475\t  render();\n   476\t  elements.search.focus();\n   477\t});\n   478\telements.cancelDelete.addEventListener('click', closeDeleteDialog);\n   479\telements.deleteForm.addEventListener('submit', event => {\n   480\t  event.preventDefault();\n   481\t  const task = tasks.find(candidate => candidate.id === deletingTaskId);\n   482\t  if (!task) { setNotice(elements.deleteError, 'This task is no longer available.'); return; }\n   483\t  if (!persist(tasks.filter(candidate => candidate.id !== task.id))) {\n   484\t    setNotice(elements.deleteError, 'The task could not be deleted. Please try again.');\n   485\t    return;\n   486\t  }\n   487\t  closeDeleteDialog();\n   488\t  render();\n   489\t  showFeedback('Task deleted.');\n   490\t});\n   491\telements.focusForm.addEventListener('submit', event => {\n   492\t  event.preventDefault();\n   493\t  const task = tasks.find(candidate => candidate.id === elements.focusTask.value);\n   494\t  try {\n   495\t    const session = createFocusSession(task, Number(elements.focusDuration.value));\n   496\t    if (persistFocus(session, focusHistory)) {\n   497\t      focusRecoveryNotice = false;\n   498\t      renderFocus();\n   499\t      syncFocusTimer();\n   500\t      showFeedback(`Focus started for ${session.taskTitle}.`);\n   501\t    }\n   502\t  } catch (error) {\n   503\t    showFeedback(String(error.message || error));\n   504\t  }\n   505\t});\n   506\telements.focusPause.addEventListener('click', () => pauseActiveFocus());\n   507\telements.focusResume.addEventListener('click', () => {\n   508\t  if (!activeFocusSession) return;\n   509\t  try {\n   510\t    const resumed = resumeFocusSession(activeFocusSession);\n   511\t    if (persistFocus(resumed, focusHistory)) {\n   512\t      focusRecoveryNotice = false;\n   513\t      renderFocus();\n   514\t      syncFocusTimer();\n   515\t      showFeedback('Focus timer resumed.');\n   516\t    }\n   517\t  } catch (error) { showFeedback(String(error.message || error)); }\n   518\t});\n   519\telements.focusFinish.addEventListener('click', () => endFocusSession('finishedEarly'));\n   520\telements.focusCancel.addEventListener('click', () => endFocusSession('cancelled'));\n","exit_code":0,"duration":{"secs":0,"nanos":2292},"formatted_output":"     1\timport {\n     2\t  createTask,\n     3\t  editTask,\n     4\t  filterTasks,\n     5\t  formatDueDate,\n     6\t  localToday,\n     7\t  setTaskCompleted\n     8\t} from './domain.js';\n     9\timport {\n    10\t  checkpointFocusSession,\n    11\t  createFocusSession,\n    12\t  finishFocusSession,\n    13\t  focusProgress,\n    14\t  formatFocusDuration,\n    15\t  pauseFocusSession,\n    16\t  recoverFocusSession,\n    17\t  resumeFocusSession\n    18\t} from './focus.js';\n    19\timport { loadFocusData, loadTasks, saveFocusData, saveTasks } from './storage.js';\n    20\t\n    21\tconst elements = {\n    22\t  cancelDelete: document.querySelector('#cancel-delete'),\n    23\t  cancelDialog: document.querySelector('#cancel-dialog'),\n    24\t  clearFilters: document.querySelector('#clear-filters'),\n    25\t  closeDialog: document.querySelector('#close-dialog'),\n    26\t  completedCount: document.querySelector('#completed-count'),\n    27\t  deleteDialog: document.querySelector('#delete-dialog'),\n    28\t  deleteDescription: document.querySelector('#delete-description'),\n    29\t  deleteError: document.querySelector('#delete-error'),\n    30\t  deleteForm: document.querySelector('#delete-form'),\n    31\t  dialogTitle: document.querySelector('#dialog-title'),\n    32\t  dueCount: document.querySelector('#due-count'),\n    33\t  emptyAction: document.querySelector('#empty-action'),\n    34\t  emptyDescription: document.querySelector('#empty-description'),\n    35\t  emptyState: document.querySelector('#empty-state'),\n    36\t  emptyTitle: document.querySelector('#empty-title'),\n    37\t  feedback: document.querySelector('#feedback'),\n    38\t  focusCancel: document.querySelector('#focus-cancel'),\n    39\t  focusDuration: document.querySelector('#focus-duration'),\n    40\t  focusElapsed: document.querySelector('#focus-elapsed'),\n    41\t  focusEmpty: document.querySelector('#focus-empty'),\n    42\t  focusFinish: document.querySelector('#focus-finish'),\n    43\t  focusForm: document.querySelector('#focus-form'),\n    44\t  focusHistory: document.querySelector('#focus-history'),\n    45\t  focusHistoryEmpty: document.querySelector('#focus-history-empty'),\n    46\t  focusPause: document.querySelector('#focus-pause'),\n    47\t  focusResume: document.querySelector('#focus-resume'),\n    48\t  focusRemaining: document.querySelector('#focus-remaining'),\n    49\t  focusSetup: document.querySelector('#focus-setup'),\n    50\t  focusState: document.querySelector('#focus-state'),\n    51\t  focusStorageError: document.querySelector('#focus-storage-error'),\n    52\t  focusTask: document.querySelector('#focus-task'),\n    53\t  focusTitle: document.querySelector('#focus-title'),\n    54\t  focusTimer: document.querySelector('#focus-timer'),\n    55\t  focusTimerNote: document.querySelector('#focus-timer-note'),\n    56\t  form: document.querySelector('#task-form'),\n    57\t  formError: document.querySelector('#form-error'),\n    58\t  navCount: document.querySelector('#nav-count'),\n    59\t  newTask: document.querySelector('#new-task'),\n    60\t  openCount: document.querySelector('#open-count'),\n    61\t  priority: document.querySelector('#priority'),\n    62\t  resultCount: document.querySelector('#result-count'),\n    63\t  resultsAnnouncement: document.querySelector('#results-announcement'),\n    64\t  saveTask: document.querySelector('#save-task'),\n    65\t  search: document.querySelector('#search'),\n    66\t  status: document.querySelector('#status'),\n    67\t  storageError: document.querySelector('#storage-error'),\n    68\t  taskDialog: document.querySelector('#task-dialog'),\n    69\t  taskList: document.querySelector('#task-list'),\n    70\t  today: document.querySelector('#today')\n    71\t};\n    72\t\n    73\tfunction getBrowserStorage() {\n    74\t  try { return window.localStorage; }\n    75\t  catch { return { getItem() { throw new Error('unavailable'); }, setItem() { throw new Error('unavailable'); } }; }\n    76\t}\n    77\t\n    78\tconst browserStorage = getBrowserStorage();\n    79\tconst storageState = loadTasks(browserStorage);\n    80\tconst focusStorageState = loadFocusData(browserStorage);\n    81\tlet tasks = storageState.tasks;\n    82\tlet activeFocusSession = focusStorageState.activeSession;\n    83\tlet focusHistory = focusStorageState.history;\n    84\tlet editableTaskId = null;\n    85\tlet deletingTaskId = null;\n    86\tlet opener = null;\n    87\tlet toastTimer;\n    88\tlet focusTimerInterval;\n    89\tlet focusWritable = focusStorageState.writable;\n    90\tlet focusRecoveryNotice = false;\n    91\t\n    92\tfunction setText(selector, value) {\n    93\t  document.querySelector(selector).textContent = value;\n    94\t}\n    95\t\n    96\tfunction setNotice(element, message) {\n    97\t  element.textContent = message;\n    98\t  element.hidden = !message;\n    99\t}\n   100\t\n   101\tfunction showFeedback(message) {\n   102\t  clearTimeout(toastTimer);\n   103\t  elements.feedback.textContent = message;\n   104\t  elements.feedback.hidden = false;\n   105\t  toastTimer = window.setTimeout(() => { elements.feedback.hidden = true; }, 3600);\n   106\t}\n   107\t\n   108\tfunction activeFilters() {\n   109\t  return { search: elements.search.value, status: elements.status.value, priority: elements.priority.value };\n   110\t}\n   111\t\n   112\tfunction clearFieldErrors() {\n   113\t  elements.formError.hidden = true;\n   114\t  elements.formError.textContent = '';\n   115\t  for (const input of elements.form.querySelectorAll('input, textarea, select')) {\n   116\t    input.removeAttribute('aria-invalid');\n   117\t  }\n   118\t  for (const error of elements.form.querySelectorAll('.field-error')) error.textContent = '';\n   119\t}\n   120\t\n   121\tfunction showFieldErrors(errors) {\n   122\t  clearFieldErrors();\n   123\t  for (const [name, message] of Object.entries(errors)) {\n   124\t    const input = elements.form.elements.namedItem(name);\n   125\t    const error = document.querySelector(`#${name}-error`);\n   126\t    if (input) input.setAttribute('aria-invalid', 'true');\n   127\t    if (error) error.textContent = message;\n   128\t  }\n   129\t}\n   130\t\n   131\tfunction persist(nextTasks) {\n   132\t  if (!storageState.writable) return false;\n   133\t  const result = saveTasks(browserStorage, nextTasks);\n   134\t  if (!result.ok) {\n   135\t    setNotice(elements.storageError, result.message);\n   136\t    showFeedback('Your change could not be saved.');\n   137\t    return false;\n   138\t  }\n   139\t  tasks = nextTasks;\n   140\t  return true;\n   141\t}\n   142\t\n   143\tfunction persistFocus(nextActiveSession, nextHistory) {\n   144\t  if (!focusWritable) return false;\n   145\t  const result = saveFocusData(browserStorage, nextActiveSession, nextHistory);\n   146\t  if (!result.ok) {\n   147\t    focusWritable = false;\n   148\t    setNotice(elements.focusStorageError, result.message);\n   149\t    showFeedback('Your focus session could not be saved.');\n   150\t    renderFocus();\n   151\t    return false;\n   152\t  }\n   153\t  activeFocusSession = nextActiveSession;\n   154\t  focusHistory = nextHistory;\n   155\t  return true;\n   156\t}\n   157\t\n   158\tfunction renderTask(task) {\n   159\t  const item = document.createElement('li');\n   160\t  item.className = `task-card${task.completed ? ' completed' : ''}`;\n   161\t  item.dataset.taskId = task.id;\n   162\t\n   163\t  const check = document.createElement('input');\n   164\t  check.className = 'task-check';\n   165\t  check.type = 'checkbox';\n   166\t  check.checked = task.completed;\n   167\t  check.dataset.action = 'toggle';\n   168\t  check.setAttribute('aria-label', `${task.completed ? 'Reopen' : 'Mark'} ${task.title}`);\n   169\t  item.append(check);\n   170\t\n   171\t  const content = document.createElement('div');\n   172\t  content.className = 'task-content';\n   173\t  const title = document.createElement('p');\n   174\t  title.className = 'task-title';\n   175\t  title.textContent = task.title;\n   176\t  content.append(title);\n   177\t  if (task.notes) {\n   178\t    const notes = document.createElement('p');\n   179\t    notes.className = 'task-notes';\n   180\t    notes.textContent = task.notes;\n   181\t    content.append(notes);\n   182\t  }\n   183\t  const meta = document.createElement('div');\n   184\t  meta.className = 'task-meta';\n   185\t  const priority = document.createElement('span');\n   186\t  priority.className = `badge priority-${task.priority.toLowerCase()}`;\n   187\t  priority.textContent = task.priority;\n   188\t  meta.append(priority);\n   189\t  if (task.dueDate) {\n   190\t    const due = document.createElement('span');\n   191\t    due.textContent = `Due ${formatDueDate(task.dueDate)}`;\n   192\t    if (!task.completed && task.dueDate < localToday()) due.className = 'overdue';\n   193\t    meta.append(due);\n   194\t  }\n   195\t  const estimate = document.createElement('span');\n   196\t  estimate.textContent = `${task.estimatedMinutes} min`;\n   197\t  meta.append(estimate);\n   198\t  content.append(meta);\n   199\t  item.append(content);\n   200\t\n   201\t  const actions = document.createElement('div');\n   202\t  actions.className = 'task-actions';\n   203\t  for (const [action, label] of [['focus', 'Focus'], ['edit', 'Edit'], ['delete', 'Delete']]) {\n   204\t    const button = document.createElement('button');\n   205\t    button.type = 'button';\n   206\t    button.className = 'icon-button';\n   207\t    button.dataset.action = action;\n   208\t    button.textContent = label;\n   209\t    button.setAttribute('aria-label', `${label} ${task.title}`);\n   210\t    actions.append(button);\n   211\t  }\n   212\t  item.append(actions);\n   213\t  return item;\n   214\t}\n   215\t\n   216\tfunction focusOutcomeLabel(outcome) {\n   217\t  return { completed: 'Completed', finishedEarly: 'Finished early', cancelled: 'Cancelled' }[outcome];\n   218\t}\n   219\t\n   220\tfunction formatFocusDate(value) {\n   221\t  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(value));\n   222\t}\n   223\t\n   224\tfunction updateFocusTimer() {\n   225\t  if (!activeFocusSession) return;\n   226\t  const progress = focusProgress(activeFocusSession);\n   227\t  elements.focusElapsed.textContent = formatFocusDuration(progress.focusedMilliseconds);\n   228\t  elements.focusRemaining.textContent = formatFocusDuration(progress.remainingMilliseconds);\n   229\t  if (progress.complete) completeFocusSession();\n   230\t}\n   231\t\n   232\tfunction syncFocusTimer() {\n   233\t  window.clearInterval(focusTimerInterval);\n   234\t  if (activeFocusSession?.status === 'running') {\n   235\t    updateFocusTimer();\n   236\t    if (activeFocusSession?.status !== 'running') return;\n   237\t    focusTimerInterval = window.setInterval(() => {\n   238\t      if (!activeFocusSession || document.hidden) return;\n   239\t      const checkpoint = checkpointFocusSession(activeFocusSession);\n   240\t      if (persistFocus(checkpoint, focusHistory)) {\n   241\t        renderFocus();\n   242\t        if (focusProgress(activeFocusSession).complete) completeFocusSession();\n   243\t      }\n   244\t    }, 1000);\n   245\t  }\n   246\t}\n   247\t\n   248\tfunction completeFocusSession() {\n   249\t  if (!activeFocusSession) return;\n   250\t  const record = finishFocusSession(activeFocusSession, 'completed');\n   251\t  if (persistFocus(null, [record, ...focusHistory])) {\n   252\t    focusRecoveryNotice = false;\n   253\t    renderFocus();\n   254\t    syncFocusTimer();\n   255\t    showFeedback('Focus session completed.');\n   256\t  }\n   257\t}\n   258\t\n   259\tfunction endFocusSession(outcome) {\n   260\t  if (!activeFocusSession) return;\n   261\t  const record = finishFocusSession(activeFocusSession, outcome);\n   262\t  if (persistFocus(null, [record, ...focusHistory])) {\n   263\t    focusRecoveryNotice = false;\n   264\t    renderFocus();\n   265\t    syncFocusTimer();\n   266\t    showFeedback(outcome === 'cancelled' ? 'Focus session cancelled.' : 'Focus session finished early.');\n   267\t  }\n   268\t}\n   269\t\n   270\tfunction pauseActiveFocus(message = 'Focus timer paused.') {\n   271\t  if (!activeFocusSession || activeFocusSession.status !== 'running') return;\n   272\t  const paused = pauseFocusSession(activeFocusSession);\n   273\t  if (focusProgress(paused).complete) {\n   274\t    const record = finishFocusSession(paused, 'completed');\n   275\t    if (persistFocus(null, [record, ...focusHistory])) {\n   276\t      renderFocus();\n   277\t      syncFocusTimer();\n   278\t      showFeedback('Focus session completed.');\n   279\t    }\n   280\t    return;\n   281\t  }\n   282\t  if (persistFocus(paused, focusHistory)) {\n   283\t    renderFocus();\n   284\t    syncFocusTimer();\n   285\t    showFeedback(message);\n   286\t  }\n   287\t}\n   288\t\n   289\tfunction renderFocus() {\n   290\t  const selectedTaskId = elements.focusTask.value;\n   291\t  elements.focusTask.replaceChildren(...tasks.map(task => {\n   292\t    const option = document.createElement('option');\n   293\t    option.value = task.id;\n   294\t    option.textContent = task.title;\n   295\t    return option;\n   296\t  }));\n   297\t  if (tasks.some(task => task.id === selectedTaskId)) elements.focusTask.value = selectedTaskId;\n   298\t  else if (tasks.length) elements.focusTask.value = tasks[0].id;\n   299\t  const hasActive = Boolean(activeFocusSession);\n   300\t  elements.focusSetup.hidden = hasActive;\n   301\t  elements.focusForm.hidden = hasActive;\n   302\t  elements.focusTimerNote.hidden = !focusRecoveryNotice;\n   303\t  elements.focusTimer.hidden = !hasActive;\n   304\t  if (hasActive) {\n   305\t    const progress = focusProgress(activeFocusSession);\n   306\t    elements.focusTitle.textContent = activeFocusSession.taskTitle;\n   307\t    elements.focusState.textContent = activeFocusSession.status === 'running' ? 'Running' : 'Paused';\n   308\t    elements.focusElapsed.textContent = formatFocusDuration(progress.focusedMilliseconds);\n   309\t    elements.focusRemaining.textContent = formatFocusDuration(progress.remainingMilliseconds);\n   310\t    elements.focusPause.hidden = activeFocusSession.status !== 'running';\n   311\t    elements.focusResume.hidden = activeFocusSession.status !== 'paused';\n   312\t  } else {\n   313\t    elements.focusState.textContent = 'Ready';\n   314\t  }\n   315\t  elements.focusTask.disabled = !focusWritable || !tasks.length;\n   316\t  elements.focusDuration.disabled = !focusWritable || !tasks.length;\n   317\t  elements.focusEmpty.hidden = tasks.length > 0;\n   318\t  elements.focusForm.querySelector('button[type=\"submit\"]').disabled = !focusWritable || !tasks.length;\n   319\t  elements.focusPause.disabled = !focusWritable;\n   320\t  elements.focusResume.disabled = !focusWritable;\n   321\t  elements.focusFinish.disabled = !focusWritable;\n   322\t  elements.focusCancel.disabled = !focusWritable;\n   323\t  elements.focusHistory.replaceChildren(...focusHistory.map(record => {\n   324\t    const item = document.createElement('li');\n   325\t    item.className = 'focus-history-item';\n   326\t    const title = document.createElement('strong');\n   327\t    title.textContent = record.taskTitle;\n   328\t    const detail = document.createElement('span');\n   329\t    detail.textContent = `${formatFocusDuration(record.focusedMilliseconds)} focused · ${formatFocusDate(record.endedAt)}`;\n   330\t    const outcome = document.createElement('span');\n   331\t    outcome.className = `focus-outcome ${record.outcome}`;\n   332\t    outcome.textContent = focusOutcomeLabel(record.outcome);\n   333\t    item.append(title, detail, outcome);\n   334\t    return item;\n   335\t  }));\n   336\t  elements.focusHistoryEmpty.hidden = focusHistory.length > 0;\n   337\t}\n   338\t\n   339\tfunction render() {\n   340\t  const filtered = filterTasks(tasks, activeFilters());\n   341\t  const open = tasks.filter(task => !task.completed);\n   342\t  const today = localToday();\n   343\t  const completed = tasks.length - open.length;\n   344\t  setText('#open-count', open.length);\n   345\t  setText('#due-count', open.filter(task => task.dueDate === today).length);\n   346\t  setText('#completed-count', completed);\n   347\t  setText('#nav-count', open.length);\n   348\t  setText('#result-count', filtered.length);\n   349\t  elements.resultsAnnouncement.textContent = `${filtered.length} ${filtered.length === 1 ? 'task' : 'tasks'} shown.`;\n   350\t  elements.clearFilters.hidden = !elements.search.value && elements.status.value === 'all' && elements.priority.value === 'all';\n   351\t  elements.taskList.replaceChildren(...filtered.map(renderTask));\n   352\t  const hasFilters = filtered.length !== tasks.length;\n   353\t  elements.emptyState.hidden = filtered.length > 0;\n   354\t  elements.emptyTitle.textContent = hasFilters ? 'No tasks match these filters.' : 'A clear desk. A fresh start.';\n   355\t  elements.emptyDescription.textContent = hasFilters ? 'Try a different search, status, or priority.' : 'Add your first task and give your next step a home.';\n   356\t  elements.emptyAction.textContent = hasFilters ? 'Clear filters' : 'Create your first task';\n   357\t  renderFocus();\n   358\t}\n   359\t\n   360\tfunction openTaskDialog(task = null, trigger = null) {\n   361\t  if (!storageState.writable) return;\n   362\t  opener = trigger;\n   363\t  editableTaskId = task?.id ?? null;\n   364\t  clearFieldErrors();\n   365\t  elements.form.reset();\n   366\t  elements.form.elements.priority.value = task?.priority ?? 'Medium';\n   367\t  elements.form.elements.estimatedMinutes.value = task?.estimatedMinutes ?? 25;\n   368\t  elements.form.elements.title.value = task?.title ?? '';\n   369\t  elements.form.elements.notes.value = task?.notes ?? '';\n   370\t  elements.form.elements.dueDate.value = task?.dueDate ?? '';\n   371\t  elements.dialogTitle.textContent = task ? 'Edit task' : 'New task';\n   372\t  elements.saveTask.textContent = task ? 'Save changes' : 'Create task';\n   373\t  elements.taskDialog.showModal();\n   374\t  window.setTimeout(() => elements.form.elements.title.focus(), 0);\n   375\t}\n   376\t\n   377\tfunction closeTaskDialog() {\n   378\t  elements.taskDialog.close();\n   379\t  opener?.focus();\n   380\t}\n   381\t\n   382\tfunction openDeleteDialog(task, trigger) {\n   383\t  if (!storageState.writable) return;\n   384\t  deletingTaskId = task.id;\n   385\t  opener = trigger;\n   386\t  setNotice(elements.deleteError, '');\n   387\t  elements.deleteDescription.textContent = `“${task.title}” will be permanently removed.`;\n   388\t  elements.deleteDialog.showModal();\n   389\t}\n   390\t\n   391\tfunction closeDeleteDialog() {\n   392\t  elements.deleteDialog.close();\n   393\t  opener?.focus();\n   394\t}\n   395\t\n   396\tfunction saveForm(event) {\n   397\t  event.preventDefault();\n   398\t  const input = {\n   399\t    title: elements.form.elements.title.value,\n   400\t    notes: elements.form.elements.notes.value,\n   401\t    priority: elements.form.elements.priority.value,\n   402\t    dueDate: elements.form.elements.dueDate.value,\n   403\t    estimatedMinutes: Number(elements.form.elements.estimatedMinutes.value)\n   404\t  };\n   405\t  try {\n   406\t    const now = new Date().toISOString();\n   407\t    const existing = editableTaskId ? tasks.find(task => task.id === editableTaskId) : null;\n   408\t    const next = existing\n   409\t      ? tasks.map(task => task.id === existing.id ? editTask(existing, input, now) : task)\n   410\t      : [createTask(input, { now }), ...tasks];\n   411\t    if (!existing && editableTaskId) throw new Error('This task is no longer available. Please reopen the task list.');\n   412\t    if (!persist(next)) return;\n   413\t    closeTaskDialog();\n   414\t    render();\n   415\t    showFeedback(existing ? 'Task updated.' : 'Task created.');\n   416\t  } catch (error) {\n   417\t    const message = String(error.message || error);\n   418\t    const mapping = {\n   419\t      'Enter a title of 1–120 characters.': 'title',\n   420\t      'Notes must be 2,