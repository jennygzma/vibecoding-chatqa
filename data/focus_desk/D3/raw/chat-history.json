rm.elements.notes.value = task?.notes ?? '';\n   370\t  elements.form.elements.dueDate.value = task?.dueDate ?? '';\n   371\t  elements.dialogTitle.textContent = task ? 'Edit task' : 'New task';\n   372\t  elements.saveTask.textContent = task ? 'Save changes' : 'Create task';\n   373\t  elements.taskDialog.showModal();\n   374\t  window.setTimeout(() => elements.form.elements.title.focus(), 0);\n   375\t}\n   376\t\n   377\tfunction closeTaskDialog() {\n   378\t  elements.taskDialog.close();\n   379\t  opener?.focus();\n   380\t}\n   381\t\n   382\tfunction openDeleteDialog(task, trigger) {\n   383\t  if (!storageState.writable) return;\n   384\t  deletingTaskId = task.id;\n   385\t  opener = trigger;\n   386\t  setNotice(elements.deleteError, '');\n   387\t  elements.deleteDescription.textContent = `“${task.title}” will be permanently removed.`;\n   388\t  elements.deleteDialog.showModal();\n   389\t}\n   390\t\n   391\tfunction closeDeleteDialog() {\n   392\t  elements.deleteDialog.close();\n   393\t  opener?.focus();\n   394\t}\n   395\t\n   396\tfunction saveForm(event) {\n   397\t  event.preventDefault();\n   398\t  const input = {\n   399\t    title: elements.form.elements.title.value,\n   400\t    notes: elements.form.elements.notes.value,\n   401\t    priority: elements.form.elements.priority.value,\n   402\t    dueDate: elements.form.elements.dueDate.value,\n   403\t    estimatedMinutes: Number(elements.form.elements.estimatedMinutes.value)\n   404\t  };\n   405\t  try {\n   406\t    const now = new Date().toISOString();\n   407\t    const existing = editableTaskId ? tasks.find(task => task.id === editableTaskId) : null;\n   408\t    const next = existing\n   409\t      ? tasks.map(task => task.id === existing.id ? editTask(existing, input, now) : task)\n   410\t      : [createTask(input, { now }), ...tasks];\n   411\t    if (!existing && editableTaskId) throw new Error('This task is no longer available. Please reopen the task list.');\n   412\t    if (!persist(next)) return;\n   413\t    closeTaskDialog();\n   414\t    render();\n   415\t    showFeedback(existing ? 'Task updated.' : 'Task created.');\n   416\t  } catch (error) {\n   417\t    const message = String(error.message || error);\n   418\t    const mapping = {\n   419\t      'Enter a title of 1–120 characters.': 'title',\n   420\t      'Notes must be 2,000 characters or fewer.': 'notes',\n   421\t      'Choose Low, Medium, or High.': 'priority',\n   422\t      'Enter a valid calendar date.': 'dueDate',\n   423\t      'Enter a whole number from 5 to 480.': 'estimatedMinutes'\n   424\t    };\n   425\t    const field = mapping[message];\n   426\t    if (field) showFieldErrors({ [field]: message });\n   427\t    else setNotice(elements.formError, message);\n   428\t  }\n   429\t}\n   430\t\n   431\tfunction taskAction(event) {\n   432\t  const control = event.target.closest('[data-action]');\n   433\t  if (!control) return;\n   434\t  if (control.dataset.action === 'toggle' && event.type !== 'change') return;\n   435\t  if (control.dataset.action !== 'toggle' && event.type !== 'click') return;\n   436\t  const card = control.closest('[data-task-id]');\n   437\t  const task = tasks.find(candidate => candidate.id === card?.dataset.taskId);\n   438\t  if (!task) return;\n   439\t  if (control.dataset.action === 'toggle') {\n   440\t    const nextTask = setTaskCompleted(task, control.checked);\n   441\t    if (persist(tasks.map(candidate => candidate.id === task.id ? nextTask : candidate))) {\n   442\t      render();\n   443\t      showFeedback(nextTask.completed ? 'Task completed.' : 'Task reopened.');\n   444\t    } else control.checked = task.completed;\n   445\t  }\n   446\t  if (control.dataset.action === 'focus') {\n   447\t    elements.focusTask.value = task.id;\n   448\t    document.querySelector('#focus-workspace').scrollIntoView({ behavior: 'smooth', block: 'start' });\n   449\t    elements.focusTask.focus({ preventScroll: true });\n   450\t  }\n   451\t  if (control.dataset.action === 'edit') openTaskDialog(task, control);\n   452\t  if (control.dataset.action === 'delete') openDeleteDialog(task, control);\n   453\t}\n   454\t\n   455\telements.newTask.addEventListener('click', event => openTaskDialog(null, event.currentTarget));\n   456\telements.emptyAction.addEventListener('click', event => {\n   457\t  if (elements.clearFilters.hidden) openTaskDialog(null, event.currentTarget);\n   458\t  else {\n   459\t    elements.search.value = '';\n   460\t    elements.status.value = 'all';\n   461\t    elements.priority.value = 'all';\n   462\t    render();\n   463\t  }\n   464\t});\n   465\telements.closeDialog.addEventListener('click', closeTaskDialog);\n   466\telements.cancelDialog.addEventListener('click', closeTaskDialog);\n   467\telements.form.addEventListener('submit', saveForm);\n   468\telements.taskList.addEventListener('click', taskAction);\n   469\telements.taskList.addEventListener('change', taskAction);\n   470\tfor (const element of [elements.search, elements.status, elements.priority]) element.addEventListener('input', render);\n   471\telements.clearFilters.addEventListener('click', () => {\n   472\t  elements.search.value = '';\n   473\t  elements.status.value = 'all';\n   474\t  elements.priority.value = 'all';\n   475\t  render();\n   476\t  elements.search.focus();\n   477\t});\n   478\telements.cancelDelete.addEventListener('click', closeDeleteDialog);\n   479\telements.deleteForm.addEventListener('submit', event => {\n   480\t  event.preventDefault();\n   481\t  const task = tasks.find(candidate => candidate.id === deletingTaskId);\n   482\t  if (!task) { setNotice(elements.deleteError, 'This task is no longer available.'); return; }\n   483\t  if (!persist(tasks.filter(candidate => candidate.id !== task.id))) {\n   484\t    setNotice(elements.deleteError, 'The task could not be deleted. Please try again.');\n   485\t    return;\n   486\t  }\n   487\t  closeDeleteDialog();\n   488\t  render();\n   