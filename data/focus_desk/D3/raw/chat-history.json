 clear next step is a good place to start.</p>\n    76\t      <label for=\"title\">Task title <span class=\"required\">Required</span></label><input id=\"title\" name=\"title\" maxlength=\"120\" required placeholder=\"What would you like to get done?\" aria-describedby=\"title-error\"><p class=\"field-error\" id=\"title-error\"></p>\n    77\t      <label for=\"notes\">Notes <span class=\"optional\">Optional · 2,000 characters max</span></label><textarea id=\"notes\" name=\"notes\" maxlength=\"2000\" rows=\"4\" placeholder=\"A few details, an idea, a reminder…\" aria-describedby=\"notes-error\"></textarea><p class=\"field-error\" id=\"notes-error\"></p>\n    78\t      <div class=\"form-grid\"><div><label for=\"task-priority\">Priority</label><select id=\"task-priority\" name=\"priority\" aria-describedby=\"priority-error\"><option>Low</option><option selected>Medium</option><option>High</option></select><p class=\"field-error\" id=\"priority-error\"></p></div><div><label for=\"due-date\">Due date <span class=\"optional\">Optional</span></label><input id=\"due-date\" name=\"dueDate\" type=\"date\" min=\"0001-01-01\" max=\"9999-12-31\" aria-describedby=\"dueDate-error\"><p class=\"field-error\" id=\"dueDate-error\"></p></div></div>\n    79\t      <label for=\"estimate\">Estimated minutes</label><input id=\"estimate\" class=\"estimate-input\" name=\"estimatedMinutes\" type=\"number\" min=\"5\" max=\"480\" step=\"1\" value=\"25\" required aria-describedby=\"estimate-help estimatedMinutes-error\"><span class=\"field-hint\" id=\"estimate-help\">5–480 minutes, in whole numbers</span><p class=\"field-error\" id=\"estimatedMinutes-error\"></p>\n    80\t      <p class=\"notice\" id=\"form-error\" role=\"alert\" hidden></p>\n    81\t      <div class=\"dialog-actions\"><button type=\"button\" class=\"secondary\" id=\"cancel-dialog\">Cancel</button><button class=\"primary\" type=\"submit\" id=\"save-task\">Create task</button></div>\n    82\t    </form>\n    83\t  </dialog>\n    